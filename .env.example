# Copy to .env and fill in. NEVER commit .env.

# === LLM ===
LLM_PROVIDER=groq                                # groq | openai | anthropic | ollama
GROQ_API_KEY=                                    # https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=                                  # only if LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=                               # only if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === Embeddings ===
EMBEDDING_PROVIDER=local                         # local | openai
EMBEDDING_MODEL_LOCAL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384                                # MUST match the pgvector column type

# === Database ===
DATABASE_URL=postgresql+psycopg://changetools:changetools@localhost:5432/changetools

# === Object storage (Cloudflare R2 / S3-compatible) ===
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=changetools-uploads
R2_ENDPOINT=                                     # https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=

# === Tracing (LangSmith) ===
LANGCHAIN_TRACING_V2=false                       # flip to true once LANGCHAIN_API_KEY is set
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=changetools-obsidian
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# === App ===
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000

# === Frontend (apps/web/.env.local) ===
NEXT_PUBLIC_API_URL=http://localhost:8000
